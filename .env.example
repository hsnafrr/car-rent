# The origin this site is served from, with no trailing slash.
#
# Set this in the Vercel dashboard under Project Settings, Environment
# Variables, for Production and Preview. Without it, canonical tags, hreflang
# alternates, Open Graph images, and the sitemap all point at the fallback
# domain in src/data/company.ts.
#
# Examples:
#   https://morfosa-transport.vercel.app
#   https://morfosatransport.com
NEXT_PUBLIC_SITE_URL=
